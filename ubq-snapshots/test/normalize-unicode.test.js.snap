// Snapshots of ubq. Do not edit this file. To write it: ubq --update <test file>

exports[`normalize with strip slashes > "＼＼＼＼＼eee＼＼＼＼＼＼" > normalized 1`] = `
＼＼＼＼＼EEE＼＼＼＼＼＼
`

exports[`normalize with strip slashes > "\\\\a\\\\b\\\\c\\\\d\\\\" > normalized 1`] = `
/A/B/C/D
`

exports[`normalize with strip slashes > "﹨aaaa﹨dddd﹨" > normalized 1`] = `
﹨AAAA﹨DDDD﹨
`

exports[`normalize with strip slashes > "＼bbb＼eee＼" > normalized 1`] = `
＼BBB＼EEE＼
`

exports[`normalize with strip slashes > "1/4foo.txt" > normalized 1`] = `
1/4FOO.TXT
`

exports[`normalize with strip slashes > "¼foo.txt" > normalized 1`] = `
¼FOO.TXT
`
