{
  "author": "Isaac Z. Schlueter",
  "name": "tar",
  "description": "tar for JavaScript",
  "version": "7.5.24",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isaacs/node-tar.git"
  },
  "scripts": {
    "snap": "ubq --update",
    "test": "ubq",
    "prepare": "tshy && bash scripts/build.sh",
    "preversion": "npm test",
    "postversion": "git push origin --follow-tags",
    "format": "prettier --write . --log-level warn",
    "typedoc": "typedoc --tsconfig .tshy/esm.json ./src/index.ts ./src/node/index.ts",
    "lint": "oxlint --fix src test",
    "postsnap": "npm run lint",
    "postlint": "npm run format",
    "bench": "npm run prepare && node scripts/benchmark/index.js",
    "pretest": "npm run prepare",
    "presnap": "npm run prepare"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "chmodr": "^2.0.2",
    "esbuild": "^0.28.0",
    "mutate-fs": "^2.1.1",
    "oxlint": "^1.67.0",
    "oxlint-tsgolint": "^0.23.0",
    "prettier": "^3.8.3",
    "tshy": "^4.1.2",
    "typedoc": "^0.28.19",
    "ubqtest": "^1.0.0"
  },
  "license": "BlueOak-1.0.0",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "tshy": {
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "import": {
          "types": "./dist/esm/index.d.ts",
          "default": "./dist/esm/index.min.js"
        },
        "require": {
          "types": "./dist/commonjs/index.d.ts",
          "default": "./dist/commonjs/index.min.js"
        }
      },
      "./node": {
        "import": {
          "types": "./dist/esm/node/index.d.ts",
          "default": "./dist/esm/node/index.min.js"
        },
        "require": {
          "types": "./dist/commonjs/node/index.d.ts",
          "default": "./dist/commonjs/node/index.min.js"
        }
      },
      "./raw": "./src/index.ts",
      "./node/raw": "./src/node/index.ts"
    },
    "selfLink": false
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.min.js"
      },
      "require": {
        "types": "./dist/commonjs/index.d.ts",
        "default": "./dist/commonjs/index.min.js"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/esm/node/index.d.ts",
        "default": "./dist/esm/node/index.min.js"
      },
      "require": {
        "types": "./dist/commonjs/node/index.d.ts",
        "default": "./dist/commonjs/node/index.min.js"
      }
    },
    "./raw": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/commonjs/index.d.ts",
        "default": "./dist/commonjs/index.js"
      }
    },
    "./node/raw": {
      "import": {
        "types": "./dist/esm/node/index.d.ts",
        "default": "./dist/esm/node/index.js"
      },
      "require": {
        "types": "./dist/commonjs/node/index.d.ts",
        "default": "./dist/commonjs/node/index.js"
      }
    }
  },
  "type": "module",
  "main": "./dist/commonjs/index.min.js",
  "types": "./dist/commonjs/index.d.ts",
  "module": "./dist/esm/index.min.js",
  "allowScripts": {
    "esbuild@0.28.0": true
  },
  "ubq": {
    "coverage": "full"
  }
}
