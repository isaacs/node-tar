{
  "author": "Isaac Z. Schlueter",
  "name": "tar",
  "description": "tar for JavaScript",
  "version": "7.5.24",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isaacs/node-tar.git"
  },
  "scripts": {
    "snap": "ubq --update",
    "test": "ubq",
    "test:bun": "bun node_modules/ubqtest/cli.js",
    "test:deno": "deno run -A node_modules/ubqtest/cli.js",
    "test:browser": "ubq browser install && ubq test/browser/core.test.ts",
    "test:dist": "ubq test/dist/copies.test.ts",
    "pretest:bun": "npm run prepare",
    "pretest:deno": "npm run prepare",
    "pretest:browser": "npm run prepare",
    "pretest:dist": "npm run prepare",
    "prepare": "tshy && bash scripts/build.sh",
    "preversion": "npm test",
    "postversion": "git push origin --follow-tags",
    "format": "prettier --write . --log-level warn",
    "typedoc": "typedoc --tsconfig .tshy/esm.json ./src/server/index.ts ./src/index.ts",
    "lint": "oxlint --fix src test",
    "postsnap": "npm run lint",
    "postlint": "npm run format",
    "bench": "npm run prepare && node scripts/benchmark/index.js",
    "pretest": "npm run prepare",
    "posttest": "ubq test/dist/copies.test.ts",
    "presnap": "npm run prepare"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "chmodr": "^2.0.2",
    "esbuild": "^0.28.0",
    "node-bzip2": "^1.0.2",
    "oxlint": "^1.67.0",
    "oxlint-tsgolint": "^0.23.0",
    "playwright-core": "^1.65.1",
    "prettier": "^3.8.3",
    "tshy": "^4.1.2",
    "typedoc": "^0.28.19",
    "ubqtest": "^1.0.0"
  },
  "license": "BlueOak-1.0.0",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "tshy": {
    "exports": {
      "./package.json": "./package.json",
      "./core": {
        "import": {
          "types": "./dist/esm/index.d.ts",
          "default": "./dist/esm/index.min.js"
        },
        "require": {
          "types": "./dist/commonjs/index.d.ts",
          "default": "./dist/commonjs/index.min.js"
        }
      },
      ".": {
        "import": {
          "types": "./dist/esm/server/index.d.ts",
          "default": "./dist/esm/server/index.min.js"
        },
        "require": {
          "types": "./dist/commonjs/server/index.d.ts",
          "default": "./dist/commonjs/server/index.min.js"
        }
      },
      "./core/raw": "./src/index.ts",
      "./raw": "./src/server/index.ts"
    },
    "selfLink": false
  },
  "exports": {
    "./package.json": "./package.json",
    "./core": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.min.js"
      },
      "require": {
        "types": "./dist/commonjs/index.d.ts",
        "default": "./dist/commonjs/index.min.js"
      }
    },
    ".": {
      "import": {
        "types": "./dist/esm/server/index.d.ts",
        "default": "./dist/esm/server/index.min.js"
      },
      "require": {
        "types": "./dist/commonjs/server/index.d.ts",
        "default": "./dist/commonjs/server/index.min.js"
      }
    },
    "./core/raw": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/commonjs/index.d.ts",
        "default": "./dist/commonjs/index.js"
      }
    },
    "./raw": {
      "import": {
        "types": "./dist/esm/server/index.d.ts",
        "default": "./dist/esm/server/index.js"
      },
      "require": {
        "types": "./dist/commonjs/server/index.d.ts",
        "default": "./dist/commonjs/server/index.js"
      }
    }
  },
  "type": "module",
  "main": "./dist/commonjs/server/index.min.js",
  "types": "./dist/commonjs/server/index.d.ts",
  "module": "./dist/esm/server/index.min.js",
  "allowScripts": {
    "esbuild@0.28.0": true,
    "node-bzip2@1.0.2": true
  },
  "ubq": {
    "coverage": "full",
    "exclude": [
      "test/browser/**",
      "test/dist/**"
    ]
  }
}
